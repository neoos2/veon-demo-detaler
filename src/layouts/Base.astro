---
import "../styles/tokens.css";
import "@fontsource-variable/unbounded/wght.css";
import "@fontsource-variable/murecho/wght.css";
import "../styles/global.css";
import "../styles/site.css";
import unboundedCyr from "@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url";
import murechoCyr from "@fontsource-variable/murecho/files/murecho-cyrillic-wght-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang} data-rec="R-204,R-207">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="img/logo-mobile.png" />
    <link rel="preload" as="font" type="font/woff2" href={unboundedCyr} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={murechoCyr} crossorigin />
    <meta name="theme-color" content="#FFCD00" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Detaler" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:image" content="img/logo-mobile.png" />
    <meta property="og:image:width" content="264" />
    <meta property="og:image:height" content="213" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
